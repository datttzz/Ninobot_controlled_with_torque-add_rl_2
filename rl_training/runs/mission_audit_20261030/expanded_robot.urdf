    </collision>
  </link>
  <joint name="caster_left_swivel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.24362 0.088 -0.0215"/>
    <parent link="base_link"/>
    <child link="caster_bracket_left_link"/>
    <axis xyz="0 0 1"/>
