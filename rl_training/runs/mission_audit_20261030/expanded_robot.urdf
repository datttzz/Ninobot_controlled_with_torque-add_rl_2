  <joint name="caster_right_wheel_joint" type="continuous">
    <origin rpy="1.5707963267948966 0 0" xyz="-0.016 0 -0.025"/>
    <parent link="caster_bracket_right_link"/>
    <child link="caster_right_wheel_link"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1.0" velocity="30.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <!-- Identical contact parameters on the left and right prevent artificial
       yaw.  Caster friction is lower so the swivels align without scrubbing. -->
  <gazebo reference="left_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000</kp>
    <kd>10</kd>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000</kp>
    <kd>10</kd>
  </gazebo>
  <gazebo reference="caster_left_wheel_link">
    <mu1>0.35</mu1>
    <mu2>0.35</mu2>
  </gazebo>
  <gazebo reference="caster_right_wheel_link">
    <mu1>0.35</mu1>
    <mu2>0.35</mu2>
  </gazebo>
  <!--
    Gazebo exposes actual wheel torque command interfaces. Position and
    velocity feedback are measured states, not ideal velocity actuators.
    The +/-12 N.m limits match the wheel-joint limits above.
  -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="effort">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="effort">
        <param name="min">-12.0</param>
        <param name="max">12.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- Register the Gazebo IMU with ros2_control as well. This keeps the
         hardware model complete; /imu/data is still published by ros_gz_bridge. -->
    <sensor name="imu_sensor">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
    <!-- Passive caster joints are exported for complete /joint_states. -->
    <joint name="caster_left_swivel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="caster_left_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="caster_right_swivel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="caster_right_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <!-- Đo pose vật lý của model; không điều khiển hay sửa quán tính/ma sát. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/ground_truth/odom</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
      <gaussian_noise>0</gaussian_noise>
    </plugin>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/tiendat/project/Ninobot_controlled_with_torque-add_rl_2/install/nino_control/share/nino_control/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
