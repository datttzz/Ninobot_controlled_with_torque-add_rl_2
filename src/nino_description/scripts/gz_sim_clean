#!/usr/bin/env python3
"""Chạy Gazebo và thu hồi tiến trình con khi launch đóng hoặc bị kết thúc."""

import ctypes
import os
from pathlib import Path
import signal
import subprocess
import sys
from time import monotonic, sleep


shutdown_requested = False


def request_shutdown(_signum=None, _frame=None):
    """Chỉ đánh dấu dừng; không chạy subprocess hoặc wait trong signal handler."""
    global shutdown_requested
    shutdown_requested = True


def die_with_parent(parent_pid):
    """Yêu cầu Linux kết thúc Gazebo nếu wrapper chết đột ngột."""
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(1, signal.SIGKILL) != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code))
    # Cha có thể chết ngay trước khi prctl được thiết lập.
    if os.getppid() != parent_pid:
        os.kill(os.getpid(), signal.SIGKILL)


def owned_descendants():
    """Gazebo GUI có thể fork server rồi setsid: PGID không đủ để nhận diện."""
    parents, states = {}, {}
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit():
            continue
        try:
            fields = (entry/'stat').read_text().split(') ', 1)[1].split()
            pid = int(entry.name)
            parents[pid], states[pid] = int(fields[1]), fields[0]
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
    owned, frontier = {}, {os.getpid()}
    while frontier:
        frontier = {pid for pid, parent in parents.items() if parent in frontier and pid not in owned}
        owned.update({pid: states[pid] for pid in frontier})
    return owned


def stop_child(child):
    """Thu hồi cả server đổi session; không dừng phiên Gazebo bên ngoài."""
    for signum, timeout in ((signal.SIGINT, 1.0), (signal.SIGTERM, 1.0),
                            (signal.SIGKILL, 1.0)):
        for pid, state in owned_descendants().items():
            if state == 'Z':
                continue
            try:
                os.kill(pid, signum)
            except ProcessLookupError:
                pass
        deadline = monotonic()+timeout
        while monotonic() < deadline:
            child.poll()
            owned = owned_descendants()
            for pid, state in owned.items():
                if state == 'Z' and pid != child.pid:
                    try:
                        os.waitpid(pid, os.WNOHANG)
                    except ChildProcessError:
                        pass
            if not any(state != 'Z' for state in owned.values()):
                child.wait(timeout=0.2)
                return
            sleep(0.02)
    raise RuntimeError('Không thu hồi được Gazebo sau khi gửi tín hiệu dừng')


def main():
    """Dừng được cả khi signal tới giữa lúc đang tạo tiến trình Gazebo."""
    signal.signal(signal.SIGINT, request_shutdown)
    signal.signal(signal.SIGTERM, request_shutdown)
    # Adopt grandchildren khi frontend thoát. Nhờ vậy server đã setsid vẫn
    # thuộc cây tiến trình của wrapper và có thể được thu hồi đúng chủ sở hữu.
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(36, 1) != 0:  # PR_SET_CHILD_SUBREAPER (Linux).
        raise OSError(ctypes.get_errno(), 'Cannot enable child subreaper')
    arguments = [arg for arg in sys.argv[1:] if arg]
    parent_pid = os.getpid()
    child = None
    try:
        if shutdown_requested:
            return 0
        child = subprocess.Popen(['gz', 'sim', *arguments], start_new_session=True,
                                 preexec_fn=lambda: die_with_parent(parent_pid))
        while not shutdown_requested:
            try:
                return child.wait(timeout=0.2)
            except subprocess.TimeoutExpired:
                pass
        return 0
    finally:
        if child is not None:
            stop_child(child)


if __name__ == '__main__':
    raise SystemExit(main())
